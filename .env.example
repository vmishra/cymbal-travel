# Cymbal Travels — backend env. Copy to `.env` (gitignored) and fill in.

# Gemini API key for the Live voice session (API-key mode, v1alpha).
# Reuse the key from another of your projects. NEVER commit the real value.
GOOGLE_API_KEY=

# Voice model. Default is Gemini 3.8 Live; set to the 2.5 fallback if 3.8
# is unavailable on the key.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Fallback: gemini-live-2.5-flash-native-audio

# Backend port.
PORT=8470
